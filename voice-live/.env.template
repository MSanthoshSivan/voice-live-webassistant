# Azure VoiceLive Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Azure VoiceLive API Details
AZURE_VOICELIVE_ENDPOINT=your-voicelive-endpoint
AZURE_VOICELIVE_MODEL=voicelive-supported-model
AZURE_VOICELIVE_API_KEY=your-voicelive-api-key

# Optional: Azure VoiceLive Endpoint (use default if not specified)
# AZURE_VOICELIVE_ENDPOINT=wss://api.voicelive.com/v1

# Optional: Flask secret key for session management
# SECRET_KEY=your-secret-key-change-in-production
